# systemd 服务单元文件模板
# 部署时复制到 /etc/systemd/system/mimi.service:
#   sudo cp scripts/mimi.service /etc/systemd/system/mimi.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mimi
# 详见 docs/deploy-aliyun.md

[Unit]
Description=Mimi 启蒙乐园
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/english-app
# 环境变量(百度语音密钥等),文件由 .env 提供
EnvironmentFile=/opt/english-app/.env
# JVM 堆限制为 512m(2G 内存机器预留系统资源)
# 使用稳定的符号链接路径 java-17-openjdk,升级小版本后路径不变
ExecStart=/usr/lib/jvm/java-17-openjdk/bin/java -Xmx512m -Xss256k -jar /opt/english-app/backend/target/english-app-backend-1.0.0.jar
SuccessExitStatus=143
# 崩溃自动重启
Restart=on-failure
RestartSec=5
# 日志输出到文件
StandardOutput=append:/var/log/mimi/app.log
StandardError=append:/var/log/mimi/app.log

[Install]
WantedBy=multi-user.target
